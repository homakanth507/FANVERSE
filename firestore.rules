rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'username', 'fanPoints']) &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.username is string && data.username.size() <= 64 &&
             data.fanPoints is number && data.fanPoints >= 0;
    }

    // Validation for Comments
    function isValidComment(data) {
      return data.keys().hasAll(['id', 'userId', 'author', 'content', 'room']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.author is string && data.author.size() <= 64 &&
             data.content is string && data.content.size() <= 1000 &&
             data.room is string && data.room.size() <= 64;
    }

    // Validation for CommentReply
    function isValidReply(data) {
      return data.keys().hasAll(['id', 'commentId', 'userId', 'author', 'content']) &&
             data.id is string && data.id.size() <= 128 &&
             data.commentId is string && data.commentId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.author is string && data.author.size() <= 64 &&
             data.content is string && data.content.size() <= 1000;
    }

    // Validation for PredictionVote
    function isValidPrediction(data) {
      return data.keys().hasAll(['id', 'userId', 'pollId', 'selection']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.pollId is string && data.pollId.size() <= 64 &&
             data.selection is string && data.selection.size() <= 64;
    }

    // Validation for MovieReview
    function isValidMovieReview(data) {
      return data.keys().hasAll(['id', 'movieId', 'userId', 'rating', 'review']) &&
             data.id is string && data.id.size() <= 128 &&
             data.movieId is string && data.movieId.size() <= 64 &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 10 &&
             data.review is string && data.review.size() <= 2000;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Disallow querying all users
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
                    incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Live stadium / discourse comments
    match /comments/{commentId} {
      allow read: if true; // Public live feed viewing
      allow create: if isSignedIn() && isValidId(commentId) && isValidComment(incoming());
      allow update: if isSignedIn() && isValidId(commentId) && (
        // Author updating their own content
        (existing().userId == request.auth.uid && isValidComment(incoming()) && incoming().userId == existing().userId) ||
        // Upvoting by community
        (incoming().diff(existing()).affectedKeys().hasOnly(['upvotes']) && incoming().upvotes is number)
      );
      allow delete: if isSignedIn() && isValidId(commentId) && existing().userId == request.auth.uid;

      // Nested replies
      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(replyId) && isValidReply(incoming());
        allow update: if isSignedIn() && isValidId(replyId) && (
          (existing().userId == request.auth.uid && isValidReply(incoming())) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['upvotes']) && incoming().upvotes is number)
        );
        allow delete: if isSignedIn() && isValidId(replyId) && existing().userId == request.auth.uid;
      }
    }

    // Live decider prediction votes
    match /predictions/{predictionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(predictionId) && isValidPrediction(incoming());
      allow update: if isSignedIn() && isValidId(predictionId) && existing().userId == request.auth.uid && isValidPrediction(incoming());
      allow delete: if isSignedIn() && isValidId(predictionId) && existing().userId == request.auth.uid;
    }

    // Movie reviews
    match /movieReviews/{reviewId} {
      allow read: if true; // Reviews are publicly readable
      allow create: if isSignedIn() && isValidId(reviewId) && isValidMovieReview(incoming());
      allow update: if isSignedIn() && isValidId(reviewId) && (
        (existing().userId == request.auth.uid && isValidMovieReview(incoming()) && incoming().userId == existing().userId) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount']) && incoming().helpfulCount is number)
      );
      allow delete: if isSignedIn() && isValidId(reviewId) && existing().userId == request.auth.uid;
    }
  }
}
